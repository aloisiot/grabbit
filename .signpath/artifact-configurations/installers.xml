<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installers": the NSIS setup .exe and the
     .msi built from the already-signed grabbit.exe. Paste into SignPath under
     Project > Artifact configurations, with the slug "installers". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="*-setup.exe">
      <authenticode-sign/>
    </pe-file>
    <msi-file path="*.msi">
      <authenticode-sign/>
    </msi-file>
  </zip-file>
</artifact-configuration>
