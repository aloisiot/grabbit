<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the Grabbit executable, signed
     before it is bundled into the installers. Paste into SignPath under
     Project > Artifact configurations, with the slug "app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="grabbit.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
